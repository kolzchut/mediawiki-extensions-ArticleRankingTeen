{
	"name": "ArticleRankingTeen",
	"version": "2.1.0",
	"requires": {
		"MediaWiki": ">= 1.43"
	},
	"author": [
		"Tal Koren (Interjet, Kol Zchut)",
		"Itschak Krumbein (OpenFox)",
		"Dror S. [FFS] ([https://www.kolzchut.org.il Kol-Zchut])"
	],
	"descriptionmsg": "articleranking-desc",
	"url": "https://github.com/kolzchut/mediawiki-extensions-ArticleRanking",
	"license-name": "MIT",
	"type": "other",
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\ArticleRanking\\": "includes/"
	},
	"SpecialPages": {
		"ArticleRanking": "MediaWiki\\Extension\\ArticleRanking\\SpecialArticleRankingReport",
		"ArticleRankingFeedback": "MediaWiki\\Extension\\ArticleRanking\\SpecialFeedback"
	},
	"APIModules": {
		"rank-vote": "MediaWiki\\Extension\\ArticleRanking\\Api\\ApiVote",
		"rank-votes": "MediaWiki\\Extension\\ArticleRanking\\Api\\ApiGetVotes",
		"rank-vote-message": "MediaWiki\\Extension\\ArticleRanking\\Api\\ApiVoteMessage"
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "ArticleRanking"
	},
	"ResourceModules": {
		"ext.articleRanking": {
			"scripts": "modules/article-ranking.script.js",
			"styles": "modules/article-ranking.style.less",
			"dependencies": [
				"mediawiki.jqueryMsg",
				"mediawiki.api"
			],
			"messages": [
				"ranking-vote-success",
				"ranking-vote-fail",
				"ranking-cr-form-title"
			]
		},
		"ext.articleRanking-after-vote": {
			"scripts": "modules/after-vote/after-vote.js",
			"styles": "modules/after-vote/after-vote.less",
			"messages": [
				"article-ranking-after-vote-failed",
				"article-ranking-after-vote-success",
				"article-ranking-after-vote-OK" 
			]
		},
		"ext.articleRanking.changeRequest": {
			"scripts": "modules/articleRanking.changeRequest.js",
			"dependencies": ["ext.wr.ShareBar.js", "mediawiki.Uri"]
		}
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\ArticleRanking\\Hooks",
			"services": [ "MainConfig" ]
		}
	},
	"Hooks": {
		"BeforePageDisplay": "main",
		"LoadExtensionSchemaUpdates": "main",
		"ResourceLoaderGetConfigVars": "main"
	},
	"MessagesDirs": {
		"ArticleRanking": [
			"i18n"
		]
	},
	"AvailableRights": [
		"articleranking-view-report",
		"viewfeedback"
	],
	"GroupPermissions": {
		"sysop": {
			"articleranking-view-report": true,
			"viewfeedback": true
		}
	},
	"ExtensionMessagesFiles": {
		"ArticleRankingAlias": "ArticleRanking.i18n.alias.php"
	},
	"config": {
		"ArticleRankingConfig": {
			"value": {
				"changerequest": {
					"url": "/forms/ChangeRequest/",
					"width": 750,
					"height": 650
				},
				"trackClicks": true
			}
		},
		"ArticleRankingCaptcha": {
			"value": { "siteKey": "", "secret": "" }
		},
		"ArticleRankingTemplatePath":      { "value": false },
		"ArticleRankingTemplateFileName":  { "value": "voting" },
		"ArticleRankingAddAfterVote":      { "value": false },
		"ArticleRankingAddChangeRequest":  { "value": true }
	},
	"manifest_version": 2
}
